# Postgres connection string used by Prisma
DATABASE_URL="postgresql://kanban:kanban@localhost:5432/kanban?schema=public"

# --- Using a managed provider instead (e.g. Aiven) ---
# 1. Save the provider's CA certificate to backend/certs/aiven-ca.pem
# 2. Comment out the DATABASE_URL above and uncomment this one, filling in your password:
# DATABASE_URL="postgresql://avnadmin:<password>@pg-135ebd60-kabanboard.a.aivencloud.com:19823/defaultdb?sslmode=verify-ca&sslrootcert=./certs/aiven-ca.pem"

# Secret used to sign JWTs - change this in production
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Port the Nest API listens on
PORT=4000

# Comma-separated list of origins allowed to call the API (CORS)
CORS_ORIGIN="http://localhost:3000"
